OBJECT_STORE_BUCKET=s3://example-refund-artifacts
OIDC_ISSUER_URL=https://auth.example.invalid/
OIDC_AUDIENCE=refund-api
OIDC_JWKS_URL=https://auth.example.invalid/jwks
TEMPORAL_ADDRESS_SECRET_ID=refund/dev/temporal-address
