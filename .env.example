# Copy to a secret manager or local .env (never commit real values).
NODE_ENV=development
LOG_LEVEL=info
PORT=3000
HOST=0.0.0.0

# Secret IDs only — resolve at runtime from the secret store.
DATABASE_URL_SECRET_ID=refund/dev/database-url
